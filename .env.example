# Copia este archivo como .env.local y rellena los valores de tu proyecto
# (Supabase → Project Settings → API Keys / Data API).

# URL del proyecto. Es pública; también se acepta SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publicable (opcional: esta aplicación no la usa, toda la E/S va por el servidor).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave SECRETA (sb_secret_… o la antigua service_role). Solo servidor.
# Nunca la prefijes con NEXT_PUBLIC_ ni la subas al repositorio.
SUPABASE_SECRET_KEY=

# Los endpoints de carga/lectura solo funcionan en desarrollo porque la app no
# tiene autenticación. No lo actives sin proteger antes los endpoints.
# ETL_PERMITIR_EN_PRODUCCION=true
